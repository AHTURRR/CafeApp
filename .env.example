APP_NAME=CafeApp
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database (host "postgres" = nama service di docker-compose.yml; gunakan 127.0.0.1 bila tanpa Docker)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cafeapp
DB_USERNAME=cafeapp
DB_PASSWORD=secret

# API murni: tanpa session berbasis database
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# Token Sanctum (hari)
CAFE_TOKEN_TTL_CUSTOMER_DAYS=30
CAFE_TOKEN_TTL_STAFF_DAYS=7

# Akun Owner awal (wajib diisi di production)
OWNER_NAME=Owner
OWNER_EMAIL=owner@cafe.test
OWNER_PASSWORD=password

# Port PostgreSQL di HOST (hanya untuk akses dari luar Docker). Ubah bila 5432 sudah dipakai, mis. 55432.
# Koneksi antar-container tetap memakai port 5432.
DB_HOST_PORT=5432
